{
  "name": "openchat",
  "version": "0.1.0",
  "description": "A self-hosted chat app for OpenRouter and your own local models (Ollama, LM Studio).",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJHax/OpenChat.git"
  },
  "homepage": "https://github.com/MJHax/OpenChat#readme",
  "bugs": {
    "url": "https://github.com/MJHax/OpenChat/issues"
  },
  "keywords": [
    "chat",
    "llm",
    "openrouter",
    "ollama",
    "lm-studio",
    "self-hosted",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --import tsx server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node scripts/build-if-stale.mjs && tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fake-local": "tsx test/fakeLocalServer.ts",
    "fake-search": "tsx test/fakeSearchServer.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^1.19.17",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.11.1",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
