{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "openchat",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "openchat-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "env": {
        "OPENCHAT_PORT": "3100",
        "OPENCHAT_DB": ".superpowers/verify/openchat.db"
      }
    }
  ]
}
